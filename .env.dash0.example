# Add these lines to the repo's .env on the laptop that sends to Dash0
# (C-016); .env is git-ignored, never commit the token. Without the
# COMPOSE_FILE line the stack exports to Aspire only.
COMPOSE_FILE=compose.yaml:compose.dash0.yaml
# `:` also on native Windows (compose's default separator there is `;`).
COMPOSE_PATH_SEPARATOR=:
DASH0_ENDPOINT=ingress.eu-west-1.aws.dash0.com:4317
DASH0_AUTHORIZATION_TOKEN=
# DASH0_DATASET=default
