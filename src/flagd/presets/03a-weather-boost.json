{
  "$schema": "https://flagd.dev/schema/v0/flags.json",
  "flags": {
    "otelEnabled": {
      "state": "ENABLED",
      "defaultVariant": "on",
      "variants": {
        "on": true,
        "off": false
      },
      "metadata": {
        "description": "Kill switch for tracing (Demo 1). off = no spans at all; metrics keep flowing"
      }
    },
    "telemetryLevel": {
      "state": "ENABLED",
      "defaultVariant": "full",
      "variants": {
        "full": "FULL",
        "io": "IO",
        "off": "OFF"
      },
      "metadata": {
        "description": "Trace verbosity: FULL, IO (drop INTERNAL spans) or OFF (same as otelEnabled=off)"
      }
    },
    "recordSpan": {
      "state": "ENABLED",
      "defaultVariant": "on",
      "variants": {
        "on": true,
        "off": false
      },
      "targeting": {
        "if": [
          {
            "or": [
              {
                "and": [
                  {
                    "==": [
                      {
                        "var": "service.name"
                      },
                      "geocode"
                    ]
                  },
                  {
                    "==": [
                      {
                        "var": "span.kind"
                      },
                      "server"
                    ]
                  },
                  {
                    "==": [
                      {
                        "var": "url.path"
                      },
                      "/health"
                    ]
                  }
                ]
              },
              {
                "and": [
                  {
                    "==": [
                      {
                        "var": "service.name"
                      },
                      "weather"
                    ]
                  },
                  {
                    "==": [
                      {
                        "var": "otel.scope.name"
                      },
                      "io.opentelemetry.jdbc"
                    ]
                  }
                ]
              }
            ]
          },
          "off",
          "on"
        ]
      },
      "metadata": {
        "description": "Per-span drop flag, evaluated against the semconv context; false = the span is not created (Demo 2)"
      }
    },
    "traceSampleRatio": {
      "state": "ENABLED",
      "defaultVariant": "all",
      "variants": {
        "all": 1.0,
        "half": 0.5,
        "tenth": 0.1,
        "none": 0.0
      },
      "metadata": {
        "description": "Sample ratio for root spans, 0.0-1.0 (Demo 3)"
      },
      "targeting": {
        "if": [
          {
            "and": [
              {
                "==": [
                  {
                    "var": "deployment.environment.name"
                  },
                  "production"
                ]
              },
              {
                "==": [
                  {
                    "var": "service.name"
                  },
                  "weather"
                ]
              }
            ]
          },
          "half",
          {
            "==": [
              {
                "var": "deployment.environment.name"
              },
              "production"
            ]
          },
          "tenth",
          "all"
        ]
      }
    },
    "weatherUpstreamFailure": {
      "state": "ENABLED",
      "defaultVariant": "none",
      "variants": {
        "none": 0.0,
        "incident": 0.5,
        "outage": 1.0
      },
      "metadata": {
        "description": "Fault injection in weather (application flag): share of /weather requests that fail with HTTP 503"
      }
    }
  }
}
